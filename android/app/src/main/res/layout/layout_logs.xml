<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MONOLITH LIVE LOGS"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <Button
            android:id="@+id/btn_copy_logs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="COPY"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="#1E293B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_clear_logs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="CLEAR"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="#1E293B" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#020617"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <ScrollView
            android:id="@+id/sv_logs_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_logs_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#38BDF8"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </ScrollView>
    </androidx.cardview.widget.CardView>
</LinearLayout>

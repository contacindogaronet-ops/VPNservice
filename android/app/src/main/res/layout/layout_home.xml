<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUNNEL STATUS"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCONNECTED"
                    android:textColor="#94A3B8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROXY CONFIGURATION"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_socks_host"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1E293B"
            android:hint="SOCKS5 Server (e.g. 192.168.1.50)"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_socks_port"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1E293B"
            android:hint="SOCKS5 Port (e.g. 1080)"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_dns_addr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1E293B"
            android:hint="DNS Server (e.g. 1.1.1.1)"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_toggle_vpn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONNECT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#6366F1" />

    </LinearLayout>
</ScrollView>

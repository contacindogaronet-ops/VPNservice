<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B">

    <!-- Header / Branding -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:text="NEURAL ENGINE"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- Kartu Status Utama -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_margin="24dp"
        android:background="@drawable/bg_card"
        android:padding="32dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/statusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴"
            android:textSize="48sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STANDBY"
            android:textColor="#888888"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Metrik Arsitektur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/statusCard"
        android:layout_marginHorizontal="24dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginRight="8dp"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORE PROTOCOL" android:textColor="#777777" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SOCKS5 / RFC1928" android:textColor="#E0E0E0" android:textStyle="bold" android:layout_marginTop="4dp" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginLeft="8dp"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEMORY POOL" android:textColor="#777777" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUAL (32K / 4M)" android:textColor="#E0E0E0" android:textStyle="bold" android:layout_marginTop="4dp" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Tombol Kendali Utama -->
    <TextView
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:text="TAP TO IGNITE"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

</RelativeLayout>

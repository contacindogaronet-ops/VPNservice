<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_rules_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rules Loaded: 0"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_pick_rules"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="IMPORT RULES"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#6366F1"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_clear_rules"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#334155"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_rules_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No rules active. All traffic will route to SOCKS5 proxy default."
            android:textColor="#94A3B8"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
